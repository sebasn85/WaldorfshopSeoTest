{% extends getPartial('page-design') %}

{% import "Ceres::PageDesign.Macros.LayoutContainer" as LayoutContainer %}

{% block PartialHead %}
    {% embed getPartial('page-metadata') %}
        {% if category is defined and category is not null %}
            {# Override default behaviour: Use empty title if no explicit meta title is defined #}
            {% block title category.details[0].metaTitle | default('') %}
            {% set metaDescription = category.details[0].metaDescription | default('') %}
            {% set metaRobots = metaRobots %}
        {% else %}
            {% set metaDescription = trans('Ceres::Template.homepageMetaDescription') %}
            {% set metaRobots = ceresConfig.meta.robotsHome %}
        {% endif %}

        {% block description metaDescription %}
        {% block robots metaRobots %}

    {% endembed %}
{% endblock %}

{% block PageBody %}
{% set releaseHomepageLinks = {
    "href=\"/fr/jouets-jeux/jouets-en-bois\"": "href=\"/fr/jouets-en-bois\"",
    "href=\"https://www.waldorfshop.eu/fr/jouets-jeux/jouets-en-bois\"": "href=\"/fr/jouets-en-bois\"",
    "href=\"/it/giocattoli-e-giochi/giocattoli-di-legno\"": "href=\"/it/giocattoli-di-legno\"",
    "href=\"https://www.waldorfshop.eu/it/giocattoli-e-giochi/giocattoli-di-legno\"": "href=\"/it/giocattoli-di-legno\"",
    "href=\"/es/juguetes-y-juegos/juguetes-de-madera\"": "href=\"/es/juguetes-de-madera\"",
    "href=\"https://www.waldorfshop.eu/es/juguetes-y-juegos/juguetes-de-madera\"": "href=\"/es/juguetes-de-madera\"",
    "href=\"/nl/speelgoed-en-spelletjes/houten-speelgoed\"": "href=\"/nl/houten-speelgoed\"",
    "href=\"https://www.waldorfshop.eu/nl/speelgoed-en-spelletjes/houten-speelgoed\"": "href=\"/nl/houten-speelgoed\"",
    "href=\"/nl/themawerelden/onderweg-reizen\"": "href=\"/nl/themawerelden/voor-onderweg\"",
    "href=\"https://www.waldorfshop.eu/nl/themawerelden/onderweg-reizen\"": "href=\"/nl/themawerelden/voor-onderweg\"",
    "href=\"/nl/boeken-tijdschriften/nederlandse-boeken\"": "href=\"/nl/boeken-tijdschriften\"",
    "href=\"https://www.waldorfshop.eu/nl/boeken-tijdschriften/nederlandse-boeken\"": "href=\"/nl/boeken-tijdschriften\"",
    "href=\"/waldorfshop.eu/fr/p/crayons-de-couleur-hexagonaux-12-1_10010922_19133\"": "href=\"/it/p/matite-colorate-esagonali-12-1_10010922_19133\"",
    "href=\"https://www.waldorfshop.eu/waldorfshop.eu/fr/p/crayons-de-couleur-hexagonaux-12-1_10010922_19133\"": "href=\"/it/p/matite-colorate-esagonali-12-1_10010922_19133\"",
    "href=\"waldorfshop.eu/fr/p/crayons-de-couleur-hexagonaux-12-1_10010922_19133\"": "href=\"/it/p/matite-colorate-esagonali-12-1_10010922_19133\""
} %}

    {% set shopBuilderTemplate = "" %}
    {% if category is defined and category is not null %}
        {# get shopbuilder template for category if defined #}
        {% set shopBuilderTemplate = shop_builder_category_template(category.id) %}
    {% endif %}

    {% if shopBuilderTemplate | trim is not empty %}
        {# show shopbuilder content for homepage category #}
        <div class="container-max">
            <div class="row">
                <div class="col">
                    {{ shopBuilderTemplate | replace(releaseHomepageLinks) | raw }}
                </div>
            </div>
        </div>
    {% else %}
        {% set overrideHomepage = LayoutContainer.show("Ceres::Homepage") %}
        {% if overrideHomepage | trim is not empty %}
            {# Show contents for container Ceres::Homepage #}
            {{ overrideHomepage | replace(releaseHomepageLinks) | raw }}
        {% else %}
            {# Show default homepage #}
            {% include "Ceres::Homepage.MarketingHomepage.twig" %}
        {% endif %}
    {% endif %}

{% endblock %}
