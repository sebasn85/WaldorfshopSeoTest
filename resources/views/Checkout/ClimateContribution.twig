<section class="ws-climate-contribution card card-body mb-3" data-ws-climate hidden
    aria-label="{{ trans('WaldorfshopSeoTest::Template.climateTitle') | escape('html_attr') }}"
    data-ws-climate-reload="{{ trans('WaldorfshopSeoTest::Template.climateReload') | escape('html_attr') }}"
    data-ws-climate-save-failed="{{ trans('WaldorfshopSeoTest::Template.climateSaveFailed') | escape('html_attr') }}"
    data-ws-climate-load-failed="{{ trans('WaldorfshopSeoTest::Template.climateLoadFailed') | escape('html_attr') }}"
    data-ws-climate-selected="{{ trans('WaldorfshopSeoTest::Template.climateSelected') | escape('html_attr') }}"
    data-ws-climate-ineligible="{{ trans('WaldorfshopSeoTest::Template.climateIneligible') | escape('html_attr') }}"
    data-ws-climate-updating="{{ trans('WaldorfshopSeoTest::Template.climateUpdating') | escape('html_attr') }}">
    <label class="d-flex align-items-start mb-2" style="gap:.65rem;cursor:pointer">
        <input type="checkbox" data-ws-climate-checkbox disabled style="margin-top:.3rem;flex-shrink:0" aria-describedby="ws-climate-explanation ws-climate-status">
        <strong>{{ trans('WaldorfshopSeoTest::Template.climateLabel') }}</strong>
    </label>
    <p id="ws-climate-explanation" class="small mb-2">{{ trans('WaldorfshopSeoTest::Template.climateExplanation') }}</p>
    <p class="small mb-0">{{ trans('WaldorfshopSeoTest::Template.climateTerms') }}</p>
    <p id="ws-climate-status" class="small mb-0 mt-2" data-ws-climate-status role="status" aria-live="polite"></p>
</section>
